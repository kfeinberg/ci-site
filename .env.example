# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — your key will not be committed.

# Anthropic API key — enables AI-generated summaries in `npm run edgar`.
# Without it, the scraper falls back to heuristic excerpts.
ANTHROPIC_API_KEY=

# Optional: override the model used for comm summaries (default: claude-opus-4-8).
# Haiku is cheaper/faster for this batch summarization task.
# CLARION_SUMMARY_MODEL=claude-haiku-4-5
